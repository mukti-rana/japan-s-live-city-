# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

# Required for the Japan AI Assistant (/ai-assistant).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required for accounts (login, signup, /settings).
# Create a project at https://supabase.com, then get these from
# Project Settings -> API. NEXT_PUBLIC_SUPABASE_ANON_KEY is safe to expose
# to the browser (it's the public/anon key, not the service role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Used to build email confirmation/reset links from Server
# Actions when the request Origin header isn't reliable (e.g. behind some
# proxies). Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=
